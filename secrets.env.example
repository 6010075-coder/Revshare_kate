# Copy to data/secrets.env (data/ is gitignored).

# Altegio BI MySQL (read-only replica). Powers "Refresh from Altegio" in Settings.
# Use the same read-only credentials as the internal BI replica.
# ALTEGIO_MYSQL_HOST=
# ALTEGIO_MYSQL_PORT=3306
# ALTEGIO_MYSQL_USER=
# ALTEGIO_MYSQL_PASSWORD=
# ALTEGIO_MYSQL_DATABASE=salon

# Optional legacy HTTP snapshot import (if you already have a JSON endpoint).
# ALTEGIO_SNAPSHOT_URL=https://example.internal/snapshot/{period}
# ALTEGIO_API_TOKEN=

# Google Sheets: Partnerships Altegio Revenue Accrual
# Spreadsheet id is already in partners.yaml; override only if needed.
# REVSHARE_GOOGLE_SHEET_ID=1GoEn9TiJHMI_7YQ9LkzBnLAoKRB_PvtnootyjQAta5A

# Service account JSON as a single line, or path to the downloaded key file.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_SERVICE_ACCOUNT_FILE=/absolute/path/to/service-account.json

# Share the spreadsheet with the service account client_email as Editor.

# Telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=

# SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_FROM_NAME=Altegio Integration Hub
# SMTP_REPLY_TO=
# SMTP_MODE=starttls

# Web/admin
# REVSHARE_PUBLIC_URL=https://revshare.example.altegio.com
# REVSHARE_ADMIN_USER=kate
# REVSHARE_ADMIN_PASSWORD=replace-with-a-long-random-password
# REVSHARE_WEB_BACKGROUND_TASKS=0
